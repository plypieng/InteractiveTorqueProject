# Sample .env file

# Directory where measurement CSV files are stored
ALLOWED_DIRECTORY=C:/path/to/data

# Database URL (SQLite by default; replace with PostgreSQL URL in production)
DATABASE_URL=sqlite:///C:/path/to/torque_data.db

# Celery broker and backend URLs (using Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BACKEND_URL=redis://localhost:6379/0

# Developer password
DEVELOPER_PASSWORD=your_password_here

# App mode (operator/admin)
APP_MODE=operator
